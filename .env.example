# Anthropic API Configuration
# Get your admin API key from https://console.anthropic.com
ANTHROPIC_ADMIN_API_KEY="your-anthropic-admin-api-key-here"

# Slack Bot Configuration
# Get your bot token from your Slack app's OAuth & Permissions page
# Must have the following scopes: chat:write, files:write
SLACK_BOT_TOKEN="xoxb-your-bot-token-here"

# Get your app token from your Slack app's Basic Information page
# Must have the connections:write scope
SLACK_APP_TOKEN="xapp-your-app-token-here"

# Channel to post the automated monthly usage report to (1st of each month
# at 09:00 system time). The bot must be invited to this channel.
# Use a channel name (e.g. #my-channel).
MONTHLY_REPORT_CHANNEL="#channel-name"

# Usage alert configuration.
# Per-user monthly budget = MONTHLY_PLAN_LIMIT / PLAN_MEMBER_COUNT.
# Defaults: 100 USD plan split across 9 members = $11.11/person.
MONTHLY_PLAN_LIMIT=100
PLAN_MEMBER_COUNT=9

# Path where alert subscriptions are persisted (default: ./data/alerts.json).
# In Docker, this path lives inside the container — mount a host volume so it
# survives restarts (see docker-compose.yml).
# ALERTS_FILE=./data/alerts.json
